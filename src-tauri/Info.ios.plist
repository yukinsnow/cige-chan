<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  iOS 主屏幕上显示的名字。bundle.productName 是 CigeChan（构建产物的名字，
  不能带非 ASCII），桌面端另有自己的标题，所以这里单独给 iOS 一个中文名。

  另外两个键是如实声明：词格酱不采集任何数据，也不追踪。
  缺了它们 App Store Connect 那边会一直显示「缺少隐私信息」。
-->
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>词格酱</string>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
</dict>
</plist>
