<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  CFBundleDisplayName：主屏幕上的名字。productName 是构建产物名，不能带非 ASCII。

  ITSAppUsesNonExemptEncryption：没用自有加密，声明了每次上传就不用回答出口合规问题。

  UIApplicationSceneManifest：iOS 27 SDK 起不采用 UIScene 生命周期的 app 启动即被系统杀掉。
  tao 0.35 只有 UIApplicationSupportsMultipleScenes 为 true 才走 scene 那条路，
  所以这里必须是 true，哪怕词格酱只有一个窗口。另需 vendor/tao 里的补丁，否则照样崩。
-->
<plist version="1.0">
<dict>
  <key>CFBundleDisplayName</key>
  <string>词格酱</string>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <true/>
  </dict>
</dict>
</plist>
